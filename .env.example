# ─── Server (Express + Supabase) ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local dev: Express port. On Render leave PORT unset and set API_PORT=5000
# (Next.js takes Render's PORT; Express runs privately on API_PORT).
PORT=5000
# Only needed for extra domains calling the API directly; the Render URL is
# allowed automatically.
CLIENT_ORIGIN=http://localhost:3000
# Supabase login emails allowed into the CMS. Required in production.
ADMIN_EMAILS=you@example.com

# ─── Client (Next.js) ──────────────────────────────────────────────────────────
# Local dev only. Leave UNSET on Render so the site uses its own /api.
NEXT_PUBLIC_PORTFOLIO_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Optional ──────────────────────────────────────────────────────────────────
# GitHub PAT can be set here OR via Admin Panel → Settings
GITHUB_PAT=ghp_your_github_pat_here
# Optional Puppeteer browser configuration if Chrome/Chromium is not installed
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# CHROME_PATH=/usr/bin/google-chrome
# CHROMIUM_PATH=/usr/bin/chromium-browser
