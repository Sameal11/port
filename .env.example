# ─── Server (Express + Supabase) ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=5000
# Comma-separated public frontend origins. Required for browser access in production.
CLIENT_ORIGIN=https://your-portfolio.vercel.app
# Restrict the CMS API to these Supabase users in production.
ADMIN_EMAILS=you@example.com

# ─── Client (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_PORTFOLIO_API_BASE_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Optional ──────────────────────────────────────────────────────────────────
# GitHub PAT can be set here OR via Admin Panel → Settings
GITHUB_PAT=ghp_your_github_pat_here
# Optional Puppeteer browser configuration if Chrome/Chromium is not installed
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# CHROME_PATH=/usr/bin/google-chrome
# CHROMIUM_PATH=/usr/bin/chromium-browser
